   "weight": 1.0,
   "globals": "",
   "solve": "ll n; cin >> n;\nif (n == 0) { cout << 0 << \"\\n\"; return; }\nstring s; while (n > 0) { s += char('0' + n % 2); n /= 2; }\nreverse(s.begin(), s.end());\ncout << s << \"\\n\";",
   "example": {
