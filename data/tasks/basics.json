   "globals": "",
   "solve": "string s; cin >> s;\nll r = 0; for (char c : s) if (isdigit(c)) r += c - '0';\nwhile (r >= 10) { ll t = 0; while (r) { t += r % 10; r /= 10; } r = t; }\ncout << r << \"\\n\";",
