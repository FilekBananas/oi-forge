   "weight": 1.0,
   "globals": "",
   "solve": "string s; cin >> s;\nbool neg = !s.empty() && s[0] == '-'; if (neg) s = s.substr(1);\nreverse(s.begin(), s.end());\nsize_t p = s.find_first_not_of('0'); s = (p == string::npos) ? \"0\" : s.substr(p);\ncout << (neg ? \"-\" : \"\") << s << \"\\n\";",
